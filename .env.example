# -----------------------------------------------------------------------------
# Argus: Environment Variables Configuration Template
# Copy this file to '.env' and fill in values as appropriate.
# -----------------------------------------------------------------------------

# --- Security ---
# Optional: Set a shared password to restrict dashboard access. Bypassed if blank.
APP_PASSWORD=
# Optional: signing secret for cross-tab auth cookies. Defaults to APP_PASSWORD if blank.
APP_AUTH_SECRET=

# --- Database ---
# Path to the SQLite local database file (default: sqlite:///data/app.db)
DATABASE_URL=sqlite:///data/app.db
# Optional: keep password out of DATABASE_URL by using one of these placeholders
# in DATABASE_URL: [YOUR-PASSWORD], <PASSWORD>, or __DB_PASSWORD__
# Example:
# DATABASE_URL=postgresql://postgres.project:[YOUR-PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_PASSWORD=

# --- SEC filings ---
# Required for SEC EDGAR filing refreshes. Please use format: Name/Version (email)
SEC_USER_AGENT=Argus/0.1 (your-email@example.com)

# --- Email Notifications & SMTP ---
# Required to send email alerts.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=argus-alerts@example.com
EMAIL_TO=recipient@example.com

# --- News Pipeline Controls ---
# Delay between requests to GDELT/RSS feeds to prevent rate limits (in seconds)
NEWS_REQUEST_DELAY_SECONDS=2
# Throttling duration to avoid redundant news calls (in hours)
NEWS_REFRESH_MIN_HOURS=3

# --- Market Data Providers ---
# Active provider to fetch price & fundamental data. Options: yfinance, finnhub, twelvedata, alphavantage
MARKET_DATA_PROVIDER=yfinance

# Optional: API keys for alternative market data providers (fallback activation)
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
TWELVE_DATA_API_KEY=
